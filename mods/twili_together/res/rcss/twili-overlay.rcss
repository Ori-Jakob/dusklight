/* Twili-Together toasts (src/ui/ItemToasts.cpp, src/ui/Toasts.cpp). */

toast.twili-item message {
    max-width: 420dp;
}

toast.twili-item message row.item-line {
    align-items: center;
    gap: 12dp;
}

toast.twili-item message row.icons {
    align-items: center;
    gap: 6dp;
}

toast.twili-item img.item-icon {
    display: block;
    width: 40dp;
    height: 40dp;
    flex: 0 0 40dp;
}

toast.twili-item row.icons img.item-icon {
    width: 32dp;
    height: 32dp;
    flex-basis: 32dp;
}

toast.twili-item span.player {
    font-weight: bold;
}

toast.twili-item span.more {
    opacity: 0.7;
}

toast.twili-item icon.item-fallback {
    width: 40dp;
    height: 40dp;
    flex: 0 0 40dp;
    font-size: 32dp;
    decorator: text("&#xe1a1;" center center);
}

/* Players widget (src/ui/PlayersWidget.cpp), a UiService overlay panel. Its own frame carries the
   opacity setting, so the host panel's frame is off. */

mod-panel[mod-id="dev.n0ted.twili_together"] {
    padding: 0;
    border-width: 0;
    background-color: transparent;
    font-size: var(--font-size-sm);
}

.twili-pw {
    display: block;
    max-width: 420dp;
    padding: 4dp 6dp 5dp 8dp;
    border-width: 1dp;
    border-radius: var(--radius-control);
}

.twili-pw-head {
    display: flex;
    align-items: center;
    padding-bottom: 2dp;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-2xs);
    font-weight: bold;
    text-transform: uppercase;
    color: var(--color-accent);
}

.twili-pw-title {
    flex: 1 1 auto;
    margin-right: 6dp;
}

.twili-pw-grip {
    display: none;
    font-family: var(--font-family-icons);
    font-size: var(--font-size-md);
    font-weight: normal;
    line-height: 1;
    color: var(--color-text);
}

mod-panels[interactive] .twili-pw-grip {
    display: block;
}

/* Positioned: a row is its tooltip's box, which wraps to the row's width. */
.twili-pw-row {
    position: relative;
    display: flex;
    align-items: center;
    height: 20dp;
}

.twili-pw-dot {
    flex: 0 0 8dp;
    width: 8dp;
    height: 8dp;
    margin-right: 6dp;
    border-radius: 4dp;
}

.twili-pw-name {
    flex: 0 0 auto;
    min-width: 56dp;
    max-width: 150dp;
    margin-right: 10dp;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: bold;
    color: var(--color-white);
}

.twili-pw-area {
    flex: 1 1 auto;
    max-width: 200dp;
    margin-right: 6dp;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(var(--color-text-rgb), 80%);
}

.twili-pw-tp {
    flex: 0 0 18dp;
    width: 18dp;
    height: 18dp;
    border-radius: var(--radius-small);
    font-family: var(--font-family-icons);
    font-size: var(--font-size-md);
    line-height: 18dp;
    text-align: center;
    color: var(--color-accent);
}

.twili-pw-tp.blocked {
    color: rgba(var(--color-accent-rgb), 40%);
}

mod-panels[interactive] .twili-pw-tp:hover {
    background-color: rgba(var(--color-interactive-rgb), 30%);
}

.twili-pw-tip {
    display: none;
    position: absolute;
    z-index: 10;
    top: 20dp;
    right: 0;
    padding: 4dp 8dp;
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: var(--radius-small);
    background-color: rgba(var(--color-surface-rgb), 96%);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: 1.2;
    text-align: left;
    color: var(--color-text);
    white-space: normal;
}

mod-panels[interactive] .twili-pw-tp:hover .twili-pw-tip {
    display: block;
}
