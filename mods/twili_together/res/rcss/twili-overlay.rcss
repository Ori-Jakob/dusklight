/* Twili-Together toasts (src/ui/ItemToasts.cpp, src/ui/Toasts.cpp). */

toast.twili-item message {
    max-width: 420dp;
}

toast.twili-item message row.item-line {
    align-items: center;
    gap: 12dp;
}

toast.twili-item message row.icons {
    align-items: center;
    gap: 6dp;
}

toast.twili-item img.item-icon {
    display: block;
    width: 40dp;
    height: 40dp;
    flex: 0 0 40dp;
}

toast.twili-item row.icons img.item-icon {
    width: 32dp;
    height: 32dp;
    flex-basis: 32dp;
}

toast.twili-item span.player {
    font-weight: bold;
}

toast.twili-item span.more {
    opacity: 0.7;
}

toast.twili-item icon.item-fallback {
    width: 40dp;
    height: 40dp;
    flex: 0 0 40dp;
    font-size: 32dp;
    decorator: text("&#xe1a1;" center center);
}

/* Players widget (src/ui/PlayersWidget.cpp), a UiService overlay panel. Its own frame carries the
   opacity setting, so the host panel's frame is off. Sizes are in em of the 14dp font size (times
   the size setting) that the widget sets on .twili-pw, along with its border width. */

mod-panel[mod-id="dev.n0ted.twili_together"] {
    padding: 0;
    border-width: 0;
    background-color: transparent;
    font-size: var(--font-size-sm);
}

.twili-pw {
    display: block;
    max-width: 30em;
    padding: 0.2857em 0.4286em 0.3571em 0.5714em;
    border-radius: 0.5em;
}

.twili-pw-head {
    display: flex;
    align-items: center;
    padding-bottom: 0.1667em;
    font-family: var(--font-family-heading);
    font-size: 0.8572em;
    font-weight: bold;
    text-transform: uppercase;
    color: var(--color-accent);
}

.twili-pw-title {
    flex: 1 1 auto;
    margin-right: 0.5em;
}

.twili-pw-grip {
    display: none;
    font-family: var(--font-family-icons);
    font-size: 1.3334em;
    font-weight: normal;
    line-height: 1;
    color: var(--color-text);
}

mod-panels[interactive] .twili-pw-grip {
    display: block;
}

/* Inline boxes, not flex: RmlUi sizes the panel to flex rows too narrow. The row holds the
   teleport button in its right padding and is the tooltip's box, so the tooltip wraps to it. */
.twili-pw-row {
    position: relative;
    display: block;
    height: 1.4286em;
    padding-right: 1.4286em;
    line-height: 1.4286em;
    white-space: nowrap;
}

.twili-pw-row > span {
    display: inline-block;
    vertical-align: middle;
}

.twili-pw-dot {
    width: 0.5714em;
    height: 0.5714em;
    margin-right: 0.4286em;
    border-radius: 0.2857em;
}

.twili-pw-name {
    min-width: 4em;
    margin-right: 0.7143em;
    font-weight: bold;
    color: var(--color-white);
}

.twili-pw-area {
    max-width: 14.2857em;
    margin-right: 0.4286em;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(var(--color-text-rgb), 80%);
}

.twili-pw-row > .twili-pw-tp {
    position: absolute;
    top: 0.0625em;
    right: 0;
    width: 1.125em;
    height: 1.125em;
    border-radius: 0.25em;
    font-family: var(--font-family-icons);
    font-size: 1.1429em;
    line-height: 1.125em;
    text-align: center;
    color: var(--color-accent);
}

.twili-pw-tp.blocked {
    color: rgba(var(--color-accent-rgb), 40%);
}

/* The pointer reaches the button with the menu open, or in play with the cursor shown. */
mod-panels[interactive] .twili-pw-tp:hover,
mod-panels[cursor] .twili-pw-tp:hover {
    background-color: rgba(var(--color-interactive-rgb), 30%);
}

.twili-pw-row > .twili-pw-tip {
    display: none;
    position: absolute;
    pointer-events: none;
    z-index: 10;
    top: 1.5385em;
    right: 0;
    padding: 0.3077em 0.6154em;
    border-width: 1dp;
    border-color: var(--color-border);
    border-radius: 0.3077em;
    background-color: rgba(var(--color-surface-rgb), 96%);
    font-family: var(--font-family-body);
    font-size: 0.9286em;
    line-height: 1.2;
    text-align: left;
    color: var(--color-text);
    white-space: normal;
}

mod-panels[interactive] .twili-pw-tp:hover + .twili-pw-tip,
mod-panels[cursor] .twili-pw-tp:hover + .twili-pw-tip {
    display: block;
}
